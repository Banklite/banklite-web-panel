# Variables para el web-panel (local, Render o Vercel).
# En Vercel: Project Settings -> Environment Variables, y luego REDEPLOY
# (las variables NEXT_PUBLIC_* se incrustan en el build, no se leen en runtime).
NEXT_PUBLIC_IDENTITY_API_URL=https://banklite-identity-service.onrender.com
NEXT_PUBLIC_ACCOUNT_API_URL=https://banklite-account-service.onrender.com
NEXT_PUBLIC_LEDGER_API_URL=https://banklite-ledger-service.onrender.com
NEXT_PUBLIC_TRANSFER_API_URL=https://banklite-transfer-service.onrender.com
NEXT_PUBLIC_CARD_API_URL=https://banklite-card-service.onrender.com
NEXT_PUBLIC_FRAUD_API_URL=https://banklite-fraud-service.onrender.com
NEXT_PUBLIC_NOTIFICATION_API_URL=https://banklite-notification-service.onrender.com
NEXT_PUBLIC_COMPLIANCE_API_URL=https://banklite-compliance-service.onrender.com
